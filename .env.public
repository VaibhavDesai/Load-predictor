# Load Predictor Configuration (Public/Demo Mode)
# This is a safe public configuration with mock data

# Connector mode: 'mock' for demo/testing, 'wap' for production
LP_CONNECTOR_MODE=mock

# Mock connector settings (for demo mode)
LP_MOCK_SEED=42
LP_MOCK_WEEKS_BACK=52

# Output
LP_OUTPUT_DIR=data/curves

# Processing
LP_WEEKS_BACK=52
LP_INCLUDE_TEST_MEETINGS=false
LP_DEFAULT_ENV=cprod
LP_DEFAULT_REGION=AMER

# =============================================================================
# WAP/StarRocks Configuration (production only - not needed for mock mode)
# =============================================================================
# LP_WAP_HOST=starrocks-prod.webex.com
# LP_WAP_PORT=9030
# LP_WAP_USERNAME=your_username_here
# LP_WAP_PASSWORD=your_password_here
# LP_WAP_SSL_DISABLED=false
# LP_WAP_SSL_VERIFY_CERT=true
# LP_WAP_SSL_VERIFY_IDENTITY=false
# LP_WAP_SSL_CA=/etc/ssl/cert.pem
